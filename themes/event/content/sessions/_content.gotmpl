{{ .EnableAllLanguages }}
{{ $context := . }}
{{ with partial "local-data/view-all.html" dict }}
    {{ with partial "content-adapters/create-session-content.html" (dict "sessionize" .) }}
        {{ range .pages }}{{ $.AddPage . }}{{ end }}
        {{ range .resources }}{{ $.AddResource . }}{{ end }}
    {{ end }}
{{ end }}